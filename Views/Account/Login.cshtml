<div class="login-page-wrapper">

    <div class="poster-container">

        <!-- CVAT Poster -->
        <img src="/Images/cvat-poster.png"
             alt="CVAT Poster"
             class="poster-image" />

        <!-- 🔐 LOGIN BOX INSIDE MARKED SQUARE -->
        <div class="poster-login-box">

            <h6 class="text-center fw-bold mb-3">Login to CVAT</h6>

            <form asp-action="Login" method="post">

                <input type="email"
                       name="Email"
                       class="form-control mb-2"
                       placeholder="Email"
                       required />

                <input type="password"
                       name="Password"
                       class="form-control mb-3"
                       placeholder="Password"
                       required />

                <button type="submit"
                        class="btn btn-primary w-100 fw-bold">
                    Login
                </button>

                <div class="text-center mt-2">
                    <a href="/Account/ForgotPassword" class="small">
                        Forgot Password?
                    </a>
                </div>

            </form>
        </div>

    </div>

</div>
